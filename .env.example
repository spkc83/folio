# Folio settings. Copy to .env, or export them. scripts/run.sh reads .env; a variable
# that the shell exports keeps its value. Write KEY=value, with no quotes. See README.md.
# LR_DATA_DIR=.folio-data/<demo>
# The demo dataset: retail (default) or hr. The app generates its data at the first
# start. "Demo data" in the home page's demo controls changes it while the app runs.
# "orders" is the unit-test model and needs LR_SOURCE_PATH (its Parquet file).
# LR_DEMO=retail
# LR_SOURCE_PATH=
# More sources, as JSON: source id -> {"kind": "duckdb", "path": ...},
# {"kind": "duckdb", "files": {"table": "file.parquet"}}, or {"kind": "postgres", "dsn": ...}.
# Example: {"warehouse": {"kind": "postgres", "dsn": "postgresql://user:password@host:5432/db"}}
# LR_SOURCES=
# Optional: a Parquet file of card transactions, for the discovery acceptance test.
# LR_CARD_DATA_PATH=
# A Postgres DSN for scripts/load_demo_postgres.py and the live Postgres tests.
# LR_PG_DSN=
# LR_PORT=8100
# The model tiers. The start of the name selects the provider: ollama/... (local),
# gpt-... or o3-... (OpenAI), gemini-... (Google), claude-... (Anthropic).
# LR_SMALL_MODEL=ollama/qwen2.5-coder:1.5b
# LR_FRONTIER_MODEL=gpt-...  or  gemini-...
# LR_CHECKER_MODEL=
# API keys for the cloud providers. Only the provider of a set model needs a key.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# A decision model (served on /v1/systemone, Ollama 0.35 or later) for choices in the router.
# Example: LR_DECIDE_MODEL=ollama/d3:4b-q8_0 (q8_0 tags run on any machine; MLX tags need Apple silicon)
# Hosted: LR_DECIDE_MODEL=gemini/gemini-decision-1 (the Gemini Decisions API, uses GOOGLE_API_KEY)
# LR_DECIDE_MODEL=
# The judge of the narrative. Default: LR_DECIDE_MODEL.
# LR_JUDGE_MODEL=
# The server with /v1/systemone. Default: the Ollama server.
# LR_DECIDE_BASE_URL=
# Thresholds for the decision probabilities. Tune them with the evals.
# LR_DECIDE_CONFIDENT=0.8
# LR_DECIDE_UNSURE=0.75
# LR_DECIDE_ANSWERABLE_FLOOR=0.3
# LR_JUDGE_FLOOR=0.5
# Drafts the model gets before code writes the section (claims and evidence).
# LR_NARRATE_ATTEMPTS=3
# Order the follow-up chips with the decision model (off: vocabulary order).
# LR_RANK_FOLLOW_UPS=false
# The decision model that orders the chips. Default: LR_DECIDE_MODEL.
# LR_RANK_MODEL=gemini/gemini-decision-1
# LR_PUBLIC_URL=http://localhost:3100
# Leave LR_LLM_PROVIDER empty to mix providers: it sends every tier to one provider.
# LR_LLM_PROVIDER=
# LR_OLLAMA_BASE_URL=http://localhost:11434/v1
